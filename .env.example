# =============================================================================
# XmLLM — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.

# -----------------------------------------------------------------------------
# Execution mode
# -----------------------------------------------------------------------------
# "local" or "space" — auto-detected from SPACE_ID if not set
APP_MODE=local

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Root directory for all persistent data (jobs, providers, exports, db).
# On HF Spaces with persistent storage, use /data
STORAGE_ROOT=./data

# SQLite database path (relative to STORAGE_ROOT)
DB_NAME=app.db

# -----------------------------------------------------------------------------
# HuggingFace (only relevant in Space mode)
# -----------------------------------------------------------------------------
# Set by HF automatically in Spaces — do not set manually in local mode
# SPACE_ID=
# HF_HOME=/data/.huggingface
# HF_TOKEN — set as a Space secret for private model access
# HF_TOKEN=hf_...

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
# Maximum upload file size in bytes (default: 50 MB)
MAX_UPLOAD_SIZE=52428800

# POST /ocr limits — sized for archival scanning (800 DPI A3 ≈ 124 MP)
# Maximum image upload size in bytes (default: 50 MB compressed)
MAX_OCR_IMAGE_SIZE=52428800

# Maximum decoded image dimensions in pixels (default: 150 MP)
MAX_OCR_IMAGE_PIXELS=150000000

# Allowed MIME types for upload (comma-separated)
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/tiff,image/webp

# ALTO export: drop <TextLine> elements whose engine confidence is below
# this value (0-1). The canonical document keeps every line. Unset keeps
# everything (default). Read once per process: changing it needs a server
# restart. Not retroactive: exports already on disk keep their lines;
# reprocess (batch_alto.py --no-skip-existing) to regenerate them.
#ALTO_MIN_LINE_CONFIDENCE=0.75

# -----------------------------------------------------------------------------
# Provider defaults
# -----------------------------------------------------------------------------
# Default timeout for provider execution in seconds
PROVIDER_TIMEOUT=120

# Default timeout for API-based providers in seconds
API_PROVIDER_TIMEOUT=60

# Maximum retries for API-based providers
API_PROVIDER_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Geometry
# -----------------------------------------------------------------------------
# Tolerance in pixels for bbox containment checks (child bbox may exceed parent
# by this many pixels without triggering a validation error)
BBOX_CONTAINMENT_TOLERANCE=5

# -----------------------------------------------------------------------------
# OCR engine
# -----------------------------------------------------------------------------
# Offload OCR to the remote service (scripts/ocr_service.py) instead of local
# inference. Unset = local PaddleOCR. See docs/ocr-service.md.
# OCR_SERVICE_URL=http://gpu-box:8080

# Pin the Paddle device (e.g. gpu:0). Unset = auto-select: GPU if the paddle
# build supports CUDA, else CPU.
# OCR_DEVICE=gpu:0

# Recognition batch size passed to PaddleOCR (text_recognition_batch_size).
# Pipeline default is 6; raising it (16–32) improves GPU throughput at the
# cost of recognition memory. Unset = PaddleOCR default.
# OCR_RECOGNITION_BATCH_SIZE=16

# -----------------------------------------------------------------------------
# Secrets (referenced by name in provider profiles, never serialized)
# -----------------------------------------------------------------------------
# SECRET_OPENAI_API_KEY=sk-...
# SECRET_HF_TOKEN=hf_...
